        selecttextWrapmode = dropdownDataSource.TextWrapMode.FirstOrDefault()?.Value;
        selectIndicators = dropdownDataSource.LoadingIndicatorOptions.FirstOrDefault()?.Value;
        localizedData = dropdownDataSource.LocalizationData.FirstOrDefault()?.Value;
        themeData = dropdownDataSource.ThemeData.FirstOrDefault()?.Value;
        modeData = dropdownDataSource.ModeData.FirstOrDefault()?.Value;
        dynamicPageSizes = customPageSizes;
        InitializeConfigurations();
        foreach (var setting in gridPropertiesConfigurations)
        {
            foreach (var property in setting.Value)
            {
                foreach (var item in property.Items)
                {
                    if (!checkboxValues.ContainsKey(item.Id) && item.Type == "checkbox")
                    {
                        checkboxItems[item.Id] = item;
                        checkboxValues[item.Id] = item.DefaultChecked;
                    }

                    if (!dropdownValues.ContainsKey(item.Id) && item.Type == "dropdown")
                    {
                        dropdownItems[item.Id] = item;
                        dropdownValues[item.Id] = item.Value;
                    }
                    if (!textboxValues.ContainsKey(item.Id) && item.Type == "numerictextbox")
                    {
                        textboxItems[item.Id] = item;
                        textboxValues[item.Id] = item.NumericValue ?? 0;
                    }
                }
            }
        }
        themeName = GetThemeName();
        dropdownValues["theme"] = themeName;
        localizationValue = Localization();
        dropdownValues["localization"] = localizationValue;
    }

