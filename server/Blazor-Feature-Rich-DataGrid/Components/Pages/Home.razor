    private string Localization()
    {
        switch (System.Globalization.CultureInfo.CurrentCulture.Name)
        {
            case "en-US":
                localizationValue = "en-US";
                break;
            case "de-DE":
                localizationValue = "de-DE";
                break;
            case "fr-CH":
                localizationValue = "fr-CH";
                break;
            case "zh-CN":
                localizationValue = "zh-CN";
                break;
        }
        return localizationValue;
    }

