    private void GridCreated()
    {
        StartWalkthrough();
    }

    private void StartWalkthrough()
    {
        stepIndex = 0;
        _ = UpdatePosition();
    }

    private void NextStep()
    {
        if (stepIndex < steps.Count - 1)
        {
            stepIndex++;
            _ = UpdatePosition();
        }
        else
        {
            EndWalkthrough();
        }
    }

    private void PrevStep()
    {
        if (stepIndex > 0)
        {
            stepIndex--;
            _ = UpdatePosition();
        }
    }

    private void SetStepIndex(int index)
    {
        stepIndex = index;
        _ = UpdatePosition();
    }

    private void EndWalkthrough()
    {
        stepIndex = -1;
        JsRuntime.InvokeVoidAsync("walkthroughHelper.removeWalkthroughHighlight");
    }

    private void CloseTooltip()
    {
        EndWalkthrough();
    }

    private async Task UpdatePosition()
    {
        if (stepIndex < 0 || stepIndex >= steps.Count) return;
        var step = steps[stepIndex];
        // Use JS interop to get element position and calculate tooltip position
        await HighlightElement();
        position = await JsRuntime.InvokeAsync<Position>("walkthroughHelper.calculateTooltipPosition", step.Selector, step.ArrowPosition);
        StateHasChanged();
    }

    private async Task HighlightElement()
    {
        if (stepIndex < 0 || stepIndex >= steps.Count) return;
        var step = steps[stepIndex];
        await JsRuntime.InvokeVoidAsync("walkthroughHelper.highlightElement", step.Selector);
    }
