    private void OnQueryCellInfo(QueryCellInfoEventArgs<OrderData> args)
    {
        if (args.Column.Field == "Freight" && args.Data?.Freight != null)
        {
            var freight = args.Data.Freight;
            if (freight < 50)
            {
                args.Cell.AddClass(new[] { "freight-low" });
            }
            else if (freight > 50 && freight < 100)
            {
                args.Cell.AddClass(new[] { "freight-mid" });
            }
            else
            {
                args.Cell.AddClass(new[] { "freight-high" });
            }
        }
    }

