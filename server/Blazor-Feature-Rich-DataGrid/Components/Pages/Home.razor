    <div class="@(interactionTypeValue == "Touch" ? "e-bigger parent-Grid-Container" : "parent-Grid-Container")">
        <SfGrid @ref="Grid" ID="overviewgrid" Width="100%" Height="100%" Toolbar=@FilteredToolbaritems DataSource="@Orders" EnableVirtualization="@virtualization" EnableInfiniteScrolling="@infinitescroll" ShowColumnChooser="true" AllowPdfExport="@pdfexport" AllowSorting="@allowSorting" AllowExcelExport="@excelexport" GridLines="@GridLineValue" AllowMultiSorting="@allowMultiSorting" AllowFiltering="@allowFiltering" AllowGrouping="@allowGrouping" AllowReordering="@allowColumnReordering" AllowResizing="@allowColumnResizing"
        AllowPaging="@allowPaging" AllowSelection="@selection" AllowRowDragAndDrop="@draganddrop" ContextMenuItems="@ContextMenuItems"
        EnableAltRow="@altrow" EnableHover="@hover" EnableHeaderFocus="@headerfocus"
        ShowColumnMenu="@column_menu" AllowTextWrap="@textwrap" RowHeight="@RowHeightValue">
            <GridEvents Created="GridCreated" Grouped="GroupedHandler" Grouping="GroupingHandler" OnToolbarClick="ToolbarClick" OnActionBegin="ActionBeginHandler" QueryCellInfo="OnQueryCellInfo" OnActionFailure="ActionFailureHandler" TValue="OrderData"></GridEvents>
            <GridSortSettings>
                <GridSortColumns> 
                    <GridSortColumn Field="OrderID"></GridSortColumn>
                    <GridSortColumn Field="Quantity"></GridSortColumn>
                </GridSortColumns>
            </GridSortSettings>
            <GridTextWrapSettings WrapMode="@wrapMode"></GridTextWrapSettings>
            <GridGroupSettings ShowDropArea="@dropArea" ShowGroupedColumn="@groupedColumn" ShowToggleButton="@toggleButton" ShowUngroupButton="@ungroupButton"></GridGroupSettings>
            <GridFilterSettings ImmediateModeDelay="@timeDelay" EnableCaseSensitivity="@enableCaseSensitive" IgnoreAccent="@ignoreAccent" ShowFilterBarStatus="@showFilterBar" Type="@gridFilterType" Mode="@gridFilterMode">
            </GridFilterSettings>
            <GridSearchSettings Fields=@SpecificColumns IgnoreAccent="@searchIgnoreAccent" IgnoreCase="@searchCaseSensitiveChecked" Operator="@SelectedOperator"></GridSearchSettings>
            <GridSelectionSettings EnableToggle="@toggleSelection" EnableSimpleMultiRowSelection="@simpleMultiRowSelection" CheckboxOnly="@checkboxOnly" Type="@gridCellSelectionType" CheckboxMode="@checkboxSelectionType" PersistSelection="@persistSelection"></GridSelectionSettings>
            <GridEditSettings ShowDeleteConfirmDialog="@deleteConfirm" ShowConfirmDialog="@showConfirmDialog" AllowAdding="@allowAdding" AllowDeleting="@allowDeleting" AllowEditing="@allowEditing" AllowEditOnDblClick="@allowEditonDblClick" AllowNextRowEdit="@allowNextRowEdit" Mode="@cellEditMode" NewRowPosition="@cellNewRowPosition"></GridEditSettings>
            <GridPageSettings PageCount="@pageCount" CurrentPage="@currentPage" PageSize="@pageSize" PageSizes="@dynamicPageSizes"></GridPageSettings>
            <GridAggregates>
                <GridAggregate>
                    <GridAggregateColumns>
                        <GridAggregateColumn Field="@nameof(OrderData.ProductID)" Type="AggregateType.Count">
                            <FooterTemplate>
                                @{
                                    var SumValue = (context as AggregateTemplateContext);
                                    <div id="summary_totalorders" style="display:flex !important;align-items:center !important;justify-content:center !important; gap: 5px;padding:10px;">
                                        <span class="sf-icon-shopping-cart" style="font-size:18px"></span>
                                        <span id="summary_orders" style="color:#1C1B1F,font-size:14px,font-weight:bold,margin-left:5px">
                                            Total Orders:
                                            <span style="color:#B3261E;font-size:14px;font-weight:700;">
                                                @SumValue.Count
                                            </span>
                                        </span>
                                    </div>
                                }
                            </FooterTemplate>
                        </GridAggregateColumn>
                        <GridAggregateColumn Field="@nameof(OrderData.Freight)" Type="AggregateType.Custom" Format="@FreightFormat">
                            <FooterTemplate>
                                @{
                                    var freightValues = Orders.Select(x => x.Freight);
                                    string displayValue = SelectedAggregation switch
                                    {
                                        "Sum" => freightValues.Sum().ToString(FreightFormat),
                                        "Average" => freightValues.Average().ToString(FreightFormat),
                                        "Min" => freightValues.Min().ToString(FreightFormat),
                                        "Max" => freightValues.Max().ToString(FreightFormat),
                                        "Count" => freightValues.Count().ToString(),
                                        _ => "N/A"
                                    };
                                    <div id="aggregate-menu" class="aggregate_summary" style="display:inline-flex;margin-top:3px;margin-right:10px;">
                                        <SfMenu Items="@aggregateFields" EnableScrolling="true"
                                        ShowItemOnClick="true"
                                        CssClass="footer-sum">
                                            <MenuEvents TValue="MenuFieldData" ItemSelected="OnMenuItemSelect" OnOpen="HandleMenuOpening"></MenuEvents>
                                            <MenuFieldSettings Text="Value" Children="Options"></MenuFieldSettings>
                                            <MenuTemplates TValue="MenuFieldData">
                                                <Template Context="menuItem">
                                                    @{
                                                        if (!@menuItem.ParentMenuText)
                                                        {
