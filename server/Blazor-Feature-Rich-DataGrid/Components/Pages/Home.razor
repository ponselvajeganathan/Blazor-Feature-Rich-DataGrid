    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("tooltipHandler.registerMouseDown");
            await JsRuntime.InvokeVoidAsync("resizeHandler.registerResizeCallback",
            DotNetObjectReference.Create(this));
            await JsRuntime.InvokeVoidAsync("registerResizeHandler", DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public async Task OnWindowResized()
    {
        await JsRuntime.InvokeVoidAsync("hideMenuOnResize");
        if (isMenuDesktopOpen || isMobileMenuOpen)
        {
            if (menuRef != null) await menuRef?.CloseAsync();
            if (menuMobileRef != null) await menuMobileRef?.CloseAsync();
        }
        dialogRef.HideAsync();
        isDialogVisible = false;
    }

    private RenderFragment GridLineCustomization =>@<SfMenu Items="@gridLineData" ShowItemOnClick="true" cssClass="grid-line">
        <MenuEvents TValue="MenuFieldData" ItemSelected="GridLineChange"></MenuEvents>
        <MenuFieldSettings Text="Value" Children="Options"></MenuFieldSettings>
        <MenuTemplates TValue="MenuFieldData">
            <Template Context="menuItem">
                @{
            if (!@menuItem.ParentMenuText)
            {
                if (@menuItem.Value != null && @menuItem.DefaultChecked != null)
                {
                        <SfTooltip @ref="tooltipRef"
                                   WindowCollision="true"
                                   MouseTrail="true"
                                   Target=".exclamation-container"
                                   Position="@Syncfusion.Blazor.Popups.Position.RightCenter"
                                   Content="@((menuItem.Label != null && propertyDescription.ContainsKey(menuItem.Label)) ? propertyDescription[menuItem.Label] : "")"
                                   OnOpen="@(args => BeforeOpen(args, menuItem.Label))">
                            <SfCheckBox CssClass="custom-gridline" @bind-Checked="@menuItem.DefaultChecked"> @menuItem.Value </SfCheckBox>
                            <div class="exclamation-container" style="margin-left: 10px;">
                                <span class="e-icons e-circle-info icon"></span>
                            </div>
                        </SfTooltip>
                }
            }
            else
            {
                    <div style="display:flex;align-items:center;"><span class='e-icons e-border-all'></span></div>
            }
                }
            </Template>
        </MenuTemplates>
    </SfMenu>
    ;

    private RenderFragment MenuTextboxSearch =>
    @<div>
        <SfTextBox @ref="textBoxRef" id="search-box" Placeholder="Search..." Input="OnInput" CssClass="search-input" @onclick="PositionDialogAsync"></SfTextBox>
        <SfDialog @ref="dialogRef" Width="300px" Height="195px" ShowCloseIcon="false" Visible="@isDialogVisible" id="dialog_search">
            <DialogEvents Opened="@HandleDialogOpen"></DialogEvents>
            <DialogPositionData X="@OffsetX" Y="@OffsetY"></DialogPositionData>
            <Content>
                <div class="filter-container">
                    <div class="filter-row">
                        <div class="search-column-group">
                            <label>Search by</label>
                            <SfDropDownList TItem="string" TValue="string"
                                            @bind-Value="SelectedField"
                                            DataSource="@FieldNames"
                                            Placeholder="ShipCountry"
                                            PopupHeight="220px">
                                <DropDownListEvents ValueChange="@SearchColumnFieldsChange" TItem="string" TValue="string"></DropDownListEvents>
                            </SfDropDownList>
                        </div>

                        <div class="search-operator-group">
                            <label>Operator</label>
                            <SfDropDownList TItem="OperatorModel" TValue="Operator"
                                            @bind-Value="SelectedOperator"
                                            DataSource="@OperatorOptions"
                                            Placeholder="equal"
                                            PopupHeight="220px">
                                <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
                                <DropDownListEvents ValueChange="@SearchOperatorValueChange" TItem="OperatorModel" TValue="Operator"></DropDownListEvents>
                            </SfDropDownList>
                        </div>
                    </div>
                    <div class="check-text">
                        <label>Text Preferences</label>
                        <div class="search-checkbox-group">
                            <label class="checkbox-item">
                                <input type="checkbox" id="case-sensitive" name="CaseSensitiveChecked" onchange="@caseSensitiveChanged" />
                            Case sensitive
                            </label>
                            <span class="line"> | </span>
                            <label class="checkbox-item">
                                <input type="checkbox" id="ignore-accent" name="IgnoreAccentChecked" onchange="@ignoreAccentChanged" />
                            Ignore accent</label>
                        </div>
                    </div>
                </div>
            </Content>
            <FooterTemplate>
                <div>
                    <SfChip Id="chip-choice" Selection="Syncfusion.Blazor.Buttons.SelectionType.Single" SelectedChips="@SelectedChipIndexes">
                        <ChipEvents OnClick="ChipClickHandler"></ChipEvents>
                        <ChipItems>
                            <ChipItem Text="Clear Search" CssClass="selectchip"></ChipItem>
                            <ChipItem Text="Search" CssClass="selectchip"></ChipItem>
                        </ChipItems>
                    </SfChip>
                </div>
            </FooterTemplate>
        </SfDialog>
    </div>;


    private RenderFragment SettingsIconTemplate =>
    @<div>
        <span style='font-size:16px;pointer-events:none !important' id="settigs_icon" class='e-icons e-settings icon'></span>
        @if(DialogVisibility)
        {
            <div>
                <SfDialog Height="100%" id="example_dialog" Width="720px" Header="Settings" ShowCloseIcon="true" IsModal="true" @bind-Visible="Visibility">
                    <DialogTemplates>
                        <Content>
                            <div id="sblist-wrapper" class="control-section">
                                <div id="sidelistwrapper">
                                    <div class="listmaincontent">
                                        <div>
                                            <div id="listContent" class="listcontent">
                                                <div class="checkbox-group">
                                                @if (gridPropertiesConfigurations.TryGetValue(SelectedListValue, out var gridProperties))
                                                {
                                                    @foreach (var property in gridProperties)
                                                    {
                                                        <div class="treeviewdiv">
                                                            <div style="font-weight:600; font-size:15px;margin-bottom:5px;">@property.GroupField</div>
                                                            @foreach (var item in property.Items)
                                                            {
                                                                @if (item?.Type != "Separator")
                                                                {
                                                                    <SfTooltip @ref="tooltipRef"
                                                                               @key="@item?.Id"
                                                                               WindowCollision="true"
                                                                               MouseTrail="true"
                                                                               Target=".exclamation-container"
                                                                               Position="@Syncfusion.Blazor.Popups.Position.RightCenter"
                                                                               OnRender="@((Syncfusion.Blazor.Popups.TooltipEventArgs args) => OnTooltipRender(item?.Label))">
                                                                        <ContentTemplate>
                                                                            <div>@tooltipContent</div>
                                                                        </ContentTemplate>
                                                                        <ChildContent>
                                                                            <div class="@($"{item.Label}-custom-label")" style="display: flex; align-items: center;@(item.Type != "Separator" ? "margin-bottom:5px;" : "0px")">
                                                                                @if (item.Type == "dropdown")
                                                                                {
                                                                                    <div style="display: flex; align-items: center; justify-content: flex-start; width: 100%;">
                                                                                        <label class="dropdownlabel"
                                                                                               style="font-size: 14px; font-weight: 400; white-space: nowrap;color:@(item.DisabledAPI ? "grey" : "black");opacity:@(item.DisabledAPI ? "0.6" : "1")">
                                                                                            @item.Label
                                                                                        </label>
                                                                                        <div class="exclamation-container" style="@($"{("margin-left: 10px;")} color: {(item.DisabledAPI ? "grey" : "black")}; opacity: {(item.DisabledAPI ? "0.6" : "1")};")">
                                                                                            <span class="e-icons e-circle-info icon"></span>
                                                                                        </div>
                                                                                        <div style="@(string.IsNullOrEmpty(item.MarginLeft) ? null : $"margin-left:{item.MarginLeft}")">
                                                                                            <SfDropDownList TValue="string"
                                                                                                            Placeholder="@item.Placeholder"
                                                                                                            DataSource="@(item.DataSource as List<FilterOption>)"
                                                                                                            TItem="FilterOption"
                                                                                                            Enabled="@IsEnabledDropdown(item.DisabledAPI)"
                                                                                                            Value="@dropdownValues[item.Id]"
                                                                                                            ValueTemplate="@(item.ValueTemplate)"
                                                                                                            ItemTemplate="@(item.ItemTemplate)"
                                                                                                            Width="200px">
                                                                                                <DropDownListFieldSettings Text="Text"
                                                                                                                           Value="Value" Disabled="DisabledAPI">
                                                                                                </DropDownListFieldSettings>
                                                                                                <DropDownListEvents TValue="string" TItem="FilterOption" ValueChange="(args) => OnDropdownChanged(args, item, gridProperties)" />
                                                                                            </SfDropDownList>
                                                                                        </div>
                                                                                    </div>
                                                                                }
                                                                                else if (item.Type == "checkbox")
                                                                                {
                                                                                    <SfCheckBox Label="@item.Label"
                                                                                                Disabled="@IsEnabledCheckbox(item.DisabledAPI)"
                                                                                                Checked="@checkboxValues[item.Id]"
                                                                                                @onchange="(args) => OnCheckboxChanged(args, item.Id, gridProperties)" />
                                                                                    <div class="exclamation-container" style="@($"color: {(item.DisabledAPI ? "grey" : "black")}; opacity: {(item.DisabledAPI ? "0.6" : "1")};")">
                                                                                        <span class="e-icons e-circle-info icon"></span>
                                                                                    </div>
                                                                                }
                                                                                else if (item.Type == "numerictextbox")
                                                                                {
                                                                                    <div style="display: flex; align-items: center; width: 100%;">
                                                                                        <label class="numerictextlabel"
                                                                                               style="font-size: 14px; font-weight: 400; white-space: nowrap;color:@(!item.DisabledAPI ? "grey" : "black");opacity:@(!item.DisabledAPI ? "0.6" : "1")">
                                                                                            @item.Label
                                                                                        </label>
                                                                                        <div class="exclamation-container" style="@($"color: {(!item.DisabledAPI ? "grey" : "black")}; opacity: {(!item.DisabledAPI ? "0.6" : "1")};")">
                                                                                            <span class="e-icons e-circle-info icon"></span>
                                                                                        </div>
                                                                                    </div>
                                                                                    <div style="display: flex; align-items: center; justify-content: flex-end; width: 100%;">
                                                                                        <SfNumericTextBox Enabled="@IsEnabledCheckbox(item.DisabledAPI)" TValue="int?" @onchange="(args) => OnTextBoxChanged(args, item.Id, gridProperties)" Value=@textboxValues[item.Id] Width="200px"></SfNumericTextBox>
                                                                                    </div>
                                                                                }
                                                                            </div>
                                                                        </ChildContent>
                                                                    </SfTooltip>
                                                                }
                                                                else if (item.Type == "Separator")
                                                                {
                                                                    <hr className="separator-line" />
                                                                }
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <SfSidebar @ref="sidebar" id="listSidebar" EnableDock="true" DockSize="0px" Width="150px" Target=".listmaincontent" IsOpen="true">
                                <SfListView @ref="listView" TValue="ListItem" DataSource="@listViewData" CssClass="e-template-list" Height="100%" id="listSidebarList">
                                    <ListViewFieldSettings TValue="ListItem" Text="Text" Id="Id"></ListViewFieldSettings>
                                    <ListViewEvents TValue="ListItem" Clicked="OnSelect" Created="ListCreated"></ListViewEvents>
                                </SfListView>
                            </SfSidebar>
                        </div>
                    </Content>
                    <FooterTemplate>
                        <div class="dialog-footer" style="display: flex; justify-content: flex-end;">
                            <button class="e-control e-btn e-lib e-link" @onclick="HandleSaveClick">Save</button>
                            <button class="e-control e-btn e-lib e-link" @onclick="HandleApplyClick">Apply</button>
                        </div>
                    </FooterTemplate>
                </DialogTemplates>
                <DialogEvents OnOpen="@DialogOpen" Closed="@DialogClose"></DialogEvents>
            </SfDialog>
        </div>
    }
    </div>
    ;

