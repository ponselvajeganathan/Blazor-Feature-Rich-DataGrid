    private string GetUri(string themeName)
    {
        var uri = UrlHelper.ToAbsoluteUri(UrlHelper.Uri);
        return uri.AbsolutePath + "?theme=" + themeName;
    }

    private void SelectedLocalizationValue(string currentValue)
    {
        localizationValue = currentValue;
        var uri = new Uri(UrlHelper.Uri)
            .GetComponents(UriComponents.PathAndQuery, UriFormat.Unescaped);
        var query = $"?culture={Uri.EscapeDataString(currentValue)}&" +
            $"redirectUri={Uri.EscapeDataString(uri)}";
        UrlHelper.NavigateTo("/Culture/SetCulture" + query, forceLoad: true);
    }

    private async Task HandleApplyClick()
    {
        foreach (var checkboxChecked in checkboxModifiedValues)
        {
            switch (checkboxChecked.Key)
            {
                case "sorting":
                    allowSorting = checkboxChecked.Value;
                    break;
                case "multisorting":
                    allowMultiSorting = checkboxChecked.Value;
                    break;
                case "filtering":
                    allowFiltering = checkboxChecked.Value;
                    break;
                case "grouping":
                    allowGrouping = checkboxChecked.Value;
                    break;
                case "paging":
                    allowPaging = checkboxChecked.Value;
                    virtualization = !allowPaging;
                    break;
                case "immutable":
                    immutable = checkboxChecked.Value;
                    break;
                case "selection":
                    selection = checkboxChecked.Value;
                    break;
                case "draganddrop":
                    draganddrop = checkboxChecked.Value;
                    break;
                case "column_menu":
                    column_menu = checkboxChecked.Value;
                    break;
                case "textwrap":
                    textwrap = checkboxChecked.Value;
                    break;
                case "autofit":
                    autofit = checkboxChecked.Value;
                    break;
                case "altrow":
                    altrow = checkboxChecked.Value;
                    if (altrow)
                    {
                        await EnableAltRowStyle();
                    }
                    else
                    {
                        await DisableAltRowStyle();
                    }
                    break;
                case "hover":
                    hover = checkboxChecked.Value;
                    break;
                case "headerfocus":
                    headerfocus = checkboxChecked.Value;
                    break;
                case "excelexport":
                    excelexport = checkboxChecked.Value;
                    if (excelexport)
                    {
                        DisableExportExcel = false;
                    }
                    else
                    {
                        DisableExportExcel = true;
                    }
                    await JsRuntime.InvokeVoidAsync("setDisableIcons", "export_excel", DisableExportExcel);
                    break;
                case "pdfexport":
                    pdfexport = checkboxChecked.Value;
                    if (pdfexport)
                    {
                        DisableExportPdf = false;
                    }
                    else
                    {
                        DisableExportPdf = true;
                    }
                    await JsRuntime.InvokeVoidAsync("setDisableIcons", "export_pdf", DisableExportPdf);
                    break;
                case "showdroparea":
                    dropArea = checkboxChecked.Value;
                    break;
                case "showgroupedcolumn":
                    groupedColumn = checkboxChecked.Value;
                    break;
                case "showtogglebutton":
                    toggleButton = checkboxChecked.Value;
                    break;
                case "showungroupbutton":
                    ungroupButton = checkboxChecked.Value;
                    break;
                case "enablecasesensitivity":
                    enableCaseSensitive = checkboxChecked.Value;
                    break;
                case "ignoreaccent":
                    ignoreAccent = checkboxChecked.Value;
                    break;
                case "showFilterBar":
                    showFilterBar = checkboxChecked.Value;
                    break;
                case "checkboxselection":
                    checkboxSelection = checkboxChecked.Value;
                    break;
                case "toggle":
                    toggleSelection = checkboxChecked.Value;
                    break;
                case "simplemultirow":
                    simpleMultiRowSelection = checkboxChecked.Value;
                    break;
                case "persistselection":
                    persistSelection = checkboxChecked.Value;
                    break;
                case "checkboxonly":
                    checkboxOnly = checkboxChecked.Value;
                    break;
                case "adding":
                    allowAdding = checkboxChecked.Value;
                    break;
                case "deleting":
                    allowDeleting = checkboxChecked.Value;
                    CommandColumnVisibility = checkboxValues["editing"] || checkboxValues["deleting"] ? true : false;
                    if (CommandColumnVisibility)
                    {
                        CommandColumnEditVisibility = !checkboxChecked.Value;
                    }
                    break;
                case "editing":
                    allowEditing = checkboxChecked.Value;
                    CommandColumnVisibility = checkboxValues["editing"] || checkboxValues["deleting"] ? true : false;
                    if (CommandColumnVisibility)
                    {
                        CommandColumnDeleteVisibility = !checkboxChecked.Value;
                    }
                    break;
                case "editondoubleclick":
                    allowEditonDblClick = checkboxChecked.Value;
                    break;
                case "confirmdialog":
                    showConfirmDialog = checkboxChecked.Value;
                    break;
                case "deletedialog":
                    deleteConfirm = checkboxChecked.Value;
                    break;
                case "nextrowedit":
                    allowNextRowEdit = checkboxChecked.Value;
                    break;
            }
        }
        foreach (var drp in dropdownModifiedValues)
        {
            switch (drp.Key)
            {
                case "filtertype":
                    gridFilterType = Enum.Parse<Syncfusion.Blazor.Grids.FilterType>(drp.Value);
                    if (gridFilterType == Syncfusion.Blazor.Grids.FilterType.Menu || gridFilterType == Syncfusion.Blazor.Grids.FilterType.CheckBox || gridFilterType == Syncfusion.Blazor.Grids.FilterType.Excel)
                    {
                        filterTypeModified = false;
                    }
                    break;
                case "filterbarmode":
                    gridFilterMode = Enum.Parse<Syncfusion.Blazor.Grids.FilterBarMode>(drp.Value);
                    break;
                case "selectiontype":
                    gridCellSelectionType = Enum.Parse<Syncfusion.Blazor.Grids.SelectionType>(drp.Value);
                    break;
                case "checkboxmodedefault":
                    checkboxSelectionType = Enum.Parse<Syncfusion.Blazor.Grids.CheckboxSelectionType>(drp.Value);
                    break;
                case "editmode":
                    cellEditMode = Enum.Parse<Syncfusion.Blazor.Grids.EditMode>(drp.Value);
                    break;
                case "newrowposition":
                    cellNewRowPosition = Enum.Parse<Syncfusion.Blazor.Grids.NewRowPosition>(drp.Value);
                    break;
                case "localization":
                    SelectedLocalizationValue(drp.Value);
                    break;
                case "theme":
                    UrlHelper.NavigateTo(GetUri(drp.Value.ToString()), true);
                    break;
                case "interactiontype":
                    interactionTypeValue = drp.Value;
                    await JsRuntime.InvokeVoidAsync("setInteractionType", interactionTypeValue);
                    break;
                case "textwrapmode":
                    wrapMode = Enum.Parse<Syncfusion.Blazor.Grids.WrapMode>(drp.Value);
                    break;
            }
        }

        foreach (var txt in textboxModifiedValues)
        {
            switch (txt.Key)
            {
                case "pagecount":
                    pageCount = (int)txt.Value;
                    break;
                case "currentpage":
                    currentPage = (int)txt.Value;
                    break;
                case "pagesize":
                    pageSize = (int)txt.Value;
                    break;
                case "timedelay":
                    timeDelay = (int)txt.Value;
                    break;
            }
        }
    }

