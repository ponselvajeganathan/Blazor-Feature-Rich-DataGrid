        <div class="walkthrough-toolbar-overlay @(stepIndex >= 0 ? "" : "e-hidden")"></div>
        @if (stepIndex >= 0 && stepIndex < steps.Count)
        {
            <div class="walkthrough-tooltip">
                <div class="walkthrough-tooltip-@steps[stepIndex].ArrowPosition"
                style="top: @position.Top.ToString(System.Globalization.CultureInfo.InvariantCulture)px;
                        left: @position.Left.ToString(System.Globalization.CultureInfo.InvariantCulture)px;
                        display: @(position.Top == 0 && position.Left == 0 ? "none" : "block");
                        padding: 8px 16px 8px 16px;
                        background: #f9f9f9;
                        border-radius: 8px;
                        min-width: 300px;">

                    <button class="tooltip-close" @onclick="CloseTooltip">×</button>
                    <div class="walkthrough-text" style="font-size: 14px; margin-bottom: 20px; position: relative; padding: 0 30px;">
                        <span class="inner-arrow left-arrow" @onclick="PrevStep"
                        style="position: absolute; left: 0; top: 65%; transform: translateY(-50%);
                                 font-size: 14px; color: #888; cursor: pointer;">
                            &#10094;
                        </span>

                        @((MarkupString)steps[stepIndex].Content)

                        <span class="inner-arrow right-arrow" @onclick="NextStep"
                        style="position: absolute; right: 0; top: 65%; transform: translateY(-50%);
                                 font-size: 14px; color: #888; cursor: pointer;">
                            &#10095;
                        </span>
                    </div>
                    <div class="walkthrough-footer"
                    style="display: flex; justify-content: center; align-items: center; gap: 12px; flex-direction: column">
                        <div class="walkthrough-dots" style="display: flex; gap: 8px;">
                            @for (int idx = 0; idx < steps.Count; idx++)
                            {
                                var currentIdx = idx; // Create a local copy for the lambda
                                <span @onclick="() => SetStepIndex(currentIdx)"
                                class="walkthrough-dot @(currentIdx == stepIndex ? "active" : "")"
                                style="width: 10px; height: 10px; border-radius: 50%;
                                         background-color: @(currentIdx == stepIndex ? "blue" : "gray");
                                         display: inline-block; cursor: pointer;">
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

