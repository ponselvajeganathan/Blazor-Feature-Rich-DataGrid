    private async Task PositionDialogAsync(MouseEventArgs e)
    {
        await textBoxRef.FocusAsync();
        await GetWindowWidth();
        double x = e.ClientX;
        double y = e.ClientY + 15;

        if (x + assumedDialogWidth > WindowWidth)
        {
            x = WindowWidth - assumedDialogWidth - 10;
        }

        OffsetX = x.ToString();
        OffsetY = y.ToString();
        isDialogVisible = true;
    }

