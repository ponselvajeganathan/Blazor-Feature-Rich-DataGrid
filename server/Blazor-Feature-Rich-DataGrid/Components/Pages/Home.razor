    private void OnCheckboxChanged(Microsoft.AspNetCore.Components.ChangeEventArgs args, string checkboxId, List<GridProperty> properties)
    {
        bool newValue = (bool)args.Value;
        checkboxValues[checkboxId] = newValue;
        checkboxModifiedValues[checkboxId] = newValue;
        if (checkboxId == "paging" && !newValue)
        {
            textboxItems["pagecount"].DisabledAPI = !textboxItems["pagecount"].DisabledAPI;
            textboxItems["currentpage"].DisabledAPI = !textboxItems["currentpage"].DisabledAPI;
        }
        else if (checkboxId == "paging" && newValue)
        {
            textboxItems["pagecount"].DisabledAPI = !textboxItems["pagecount"].DisabledAPI;
            textboxItems["currentpage"].DisabledAPI = !textboxItems["currentpage"].DisabledAPI;
        }
        else if (checkboxId == "textwrap")
        {
            dropdownItems["textwrapmode"].DisabledAPI = !dropdownItems["textwrapmode"].DisabledAPI;
        }
        else if (checkboxId == "sorting")
        {
            checkboxItems["multisorting"].DisabledAPI = !checkboxItems["multisorting"].DisabledAPI;
        }
        else if (checkboxId == "grouping")
        {
            ToggleListViewItem("Group Settings", newValue);
        }
        else if (checkboxId == "filtering")
        {
            ToggleListViewItem("Filter Settings", newValue);
        }
        else if (checkboxId == "selection")
        {
            ToggleListViewItem("Selection Settings", newValue);
        }
        else if (checkboxId == "column_menu")
        {
            checkboxItems["autofit"].DisabledAPI = !checkboxItems["autofit"].DisabledAPI;
        }
        else if (checkboxId == "adding")
        {
            dropdownItems["newrowposition"].DisabledAPI = !dropdownItems["newrowposition"].DisabledAPI;
            if (!newValue)
            {
                dropdownItems["newrowposition"].DisabledAPI = true;
            }
        }
        else if (checkboxId == "editing")
        {
            checkboxItems["editondoubleclick"].DisabledAPI = !checkboxItems["editondoubleclick"].DisabledAPI;
            checkboxItems["nextrowedit"].DisabledAPI = !checkboxItems["nextrowedit"].DisabledAPI;

        }
        else if (checkboxId == "deleting")
        {
            checkboxItems["deletedialog"].DisabledAPI = !checkboxItems["deletedialog"].DisabledAPI;
        }
        else if (checkboxId == "checkboxselection")
        {
            dropdownItems["selectiontype"].DataSource = newValue ? dropdownDataSource.Selectiontype : dropdownDataSource.SelectiontypeModified;
            checkboxItems["toggle"].DisabledAPI = newValue ? true : false;
            checkboxItems["simplemultirow"].DisabledAPI = newValue ? true : false;
            checkboxItems["persistselection"].DisabledAPI = newValue ? false : true;
            checkboxItems["checkboxonly"].DisabledAPI = newValue ? false : true;
            dropdownItems["checkboxmodedefault"].DisabledAPI = newValue ? false : true;
        }
    }

    private void OnDropdownChanged(Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, FilterOption> args, GridItem currentItem, List<GridProperty> properties)
    {
        var newValue = args.Value;
        dropdownValues[currentItem.Id] = newValue;
        dropdownModifiedValues[currentItem.Id] = newValue;
        if (newValue == "Single")
        {
            foreach (var property in properties)
            {
                foreach (var item in property.Items)
                {
                    if (item.Id == "simplemultirow")
                    {
                        item.DisabledAPI = true;
                    }
                }
            }
        }
        else if (newValue == "OnEnter" || newValue == "Immediate")
        {
            textboxItems["timedelay"].DisabledAPI = !textboxItems["timedelay"].DisabledAPI;
        }
        else if (newValue == "Multiple")
        {
            foreach (var property in properties)
            {
                foreach (var item in property.Items)
                {
                    if (item.Id == "simplemultirow")
                    {
                        item.DisabledAPI = false;
                    }
                }
            }
        }
        else if (newValue == "Default")
        {
            foreach (var property in properties)
            {
                foreach (var item in property.Items)
                {
                    if (item.Id == "checkboxonly")
                    {
                        item.DisabledAPI = false;
                    }
                }
            }
        }
        else if (newValue == "Menu")
        {
            foreach (var property in properties)
            {
                foreach (var item in property.Items)
                {
                    if (item.Id == "filterbar" || item.Id == "barstatus" || item.Id == "filterbarmode" ||
                    item.Id == "loadingindicator")
                    {
                        item.DisabledAPI = true;
                    }
                }
            }
        }
        else if (newValue == "CheckBox" || newValue == "Excel")
        {
            foreach (var property in properties)
            {
                foreach (var item in property.Items)
                {
                    if (item.Id == "loadingindicator")
                    {
                        item.DisabledAPI = false;
                    }
                    if (item.Id == "filterbar" || item.Id == "filterbarmode")
                    {
                        item.DisabledAPI = true;
                    }
                }
            }
        }
        else if (newValue == "FilterBar")
        {
            foreach (var property in properties)
            {
                foreach (var item in property.Items)
                {
                    if (item.Id == "filterbar" || item.Id == "filterbarmode")
                    {
                        item.DisabledAPI = false;
                    }
                    if (item.Id == "loadingindicator")
                    {
                        item.DisabledAPI = true;
                    }
                }
            }
        }
        else if (newValue == "Dialog")
        {
            checkboxItems["nextrowedit"].DisabledAPI = true;
            dropdownItems["newrowposition"].DisabledAPI = true;
            checkboxItems["confirmdialog"].DisabledAPI = true;
        }
        else if (newValue == "Normal")
        {
            checkboxItems["nextrowedit"].DisabledAPI = false;
            dropdownItems["newrowposition"].DisabledAPI = false;
            checkboxItems["confirmdialog"].DisabledAPI = true;
        }
        else if (newValue == "Batch")
        {
            checkboxItems["nextrowedit"].DisabledAPI = false;
            dropdownItems["newrowposition"].DisabledAPI = false;
            checkboxItems["confirmdialog"].DisabledAPI = false;
        }
        else if (newValue == "Multiple")
        {
            checkboxItems["toggle"].DisabledAPI = true;
            checkboxItems["simplemultirow"].DisabledAPI = checkboxSelection ? true : false;
            checkboxItems["checkboxselection"].DisabledAPI = checkboxSelection ? true : false;
        }
        else if (newValue == "Single" && checkboxSelection)
        {
            checkboxItems["checkboxselection"].DisabledAPI = true;
            checkboxItems["persistselection"].DisabledAPI = true;
            checkboxItems["checkboxonly"].DisabledAPI = true;
            dropdownItems["checkboxmodedefault"].DisabledAPI = true;
        }
    }

    private void UpdateOptionChecked(List<MenuFieldData> sourceList, string targetText, MenuFieldData item)
    {
        if (!item.DefaultChecked && item.CustomText != null)
        {
            int index = sourceList.FindIndex(c => c.CustomText == targetText);
            if (index != -1)
            {
                foreach (var option in sourceList[index].Options)
                {
                    option.DefaultChecked = (option.Value == item.Value);
                }
            }
        }
    }

    private void UpdateOptionNestedChecked(List<MenuFieldData> sourceList, string targetGroup, MenuFieldData selectedItem)
    {
        if (!selectedItem.ParentMenuText)
        {
            foreach (var topLevel in sourceList)
            {
                if (topLevel.Options == null) continue;

                foreach (var group in topLevel.Options)
                {
                    if (group.CustomText == targetGroup && group.Options != null)
                    {
                        if (selectedItem.CustomText == "Data Operations" || selectedItem.CustomText == "Single Column Verified" || selectedItem.CustomText == "Frozen")
                        {
                            foreach (var option in group.Options)
                            {
                                if (option.Value == selectedItem.Value)
                                {
                                    option.SingleCheckbox = !option.SingleCheckbox;
                                }
                            }
                        }
                        else
                        {
                            foreach (var option in group.Options)
                            {
                                option.DefaultChecked = (option.Value == selectedItem.Value);
                            }
                        }
                        return;
                    }
                    else if (group.Options == null)
                    {
                        if (selectedItem.CustomText == "Single Column Verified" || selectedItem.CustomText == "Single Column Operations")
                        {
                            if (group.Value == selectedItem.Value)
                            {
                                group.SingleCheckbox = !group.SingleCheckbox;
                            }
                        }
                    }
                }
            }
        }
    }

