            "ColumnChooser",
            new ItemModel()
            {
                 Text = "",
                 Align=ItemAlign.Right,
                 Id="grid_properties",
                 Template = SettingsIconTemplate
            }
        };
        FilteredToolbaritems = Toolbaritems
        .Where(item =>
        {
            if (item is string strItem)
            {
                return strItem != "Edit" && strItem != "Update" && strItem != "Cancel" && strItem != "Delete";
            }
            return true;
        })
        .ToList();
        var selectedProperties = new[] { "OrderID", "CustomerName", "ShipAddress", "ProductName", "ProductID", "Quantity", "Freight", "ShipCountry", "Rating", "ShipName" };
        Orders = Data.GetOrders();
        FieldNames = typeof(OrderData).GetProperties().Where(p => selectedProperties.Contains(p.Name))
                                     .Select(p => p.Name)
                                     .ToList();
        PropertyTypeMap = typeof(OrderData)
        .GetProperties()
        .Where(p => selectedProperties.Contains(p.Name))
        .ToDictionary(p => p.Name, p => p.PropertyType.Name);
        OperatorOptions = OperatorStringOptions;
        selectEditMode = dropdownDataSource.EditMode.FirstOrDefault()?.Value;
        selectFilterType = dropdownDataSource.FilterBarTypeOptions.FirstOrDefault()?.Value;
        selectFilterBarMode = dropdownDataSource.FilterBarModeOptions.FirstOrDefault()?.Value;
