    public async Task ToolbarClick(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        isDialogVisible = false;
        if (args.Item.Id == "export_pdf" && pdfexport)
        {
            await Grid.HideColumnAsync("ShipCountry", "Field");
            await Grid.HideColumnAsync("ProductID", "Field");
            await Grid.HideColumnAsync("Freight", "Field");
            await Grid.HideColumnAsync("Commands");
            await Grid.ExportToPdfAsync();
            await Grid.ShowColumnAsync("ShipCountry", "Field");
            await Grid.ShowColumnAsync("ProductID", "Field");
            await Grid.ShowColumnAsync("Freight", "Field");
            await Grid.ShowColumnAsync("Commands");
        }
        else if (args.Item.Id == "expand_icon")
        {
            if (expandCollapseValue == "Grouping" && isExpand)
            {
                isExpand = false;
                await Grid.CollapseAllGroupAsync();
            }
            else
            {
                await Grid.ExpandAllGroupAsync();
                isExpand = true;
            }
        }
        else if (args.Item.Id == "export_excel" && excelexport)
        {
            await Grid.HideColumnAsync("ShipCountry", "Field");
            await Grid.HideColumnAsync("ProductID", "Field");
            await Grid.HideColumnAsync("Freight", "Field");
            await Grid.HideColumnAsync("Commands");
            await Grid.ExportToExcelAsync();
            await Grid.ShowColumnAsync("ShipCountry", "Field");
            await Grid.ShowColumnAsync("ProductID", "Field");
            await Grid.ShowColumnAsync("Freight", "Field");
            await Grid.ShowColumnAsync("Commands");
        }
        else if (args.Item.Id == "export_csv")
        {
            await Grid.HideColumnAsync("ShipCountry", "Field");
            await Grid.HideColumnAsync("ProductID", "Field");
            await Grid.HideColumnAsync("Freight", "Field");
            await Grid.HideColumnAsync("Commands");
            await Grid.ExportToCsvAsync();
            await Grid.ShowColumnAsync("ShipCountry", "Field");
            await Grid.ShowColumnAsync("ProductID", "Field");
            await Grid.ShowColumnAsync("Freight", "Field");
            await Grid.ShowColumnAsync("Commands");
        }
        else if (args.Item.Id == "clearsorting_icon")
        {
            await this.Grid.ClearSortingAsync();
        }
        else if (args.Item.Id == "clear_row_selection")
        {
            await this.Grid.ClearRowSelectionAsync();
        }
        else if (args.Item.Id == "clear_cell_selection")
        {
            await this.Grid.ClearCellSelectionAsync();
        }
        else if (args.Item.Id == "clearfilter_icon")
        {
            if (TextBoxFilterOrderID != null) TextBoxFilterOrderID.Value = string.Empty;
            if (TextBoxFilterCustomerName != null) TextBoxFilterCustomerName.Value = string.Empty;
            if (TextBoxFilterMailID != null) TextBoxFilterMailID.Value = string.Empty;
            if (TextBoxFilterProductName != null) TextBoxFilterProductName.Value = string.Empty;
            await this.Grid.ClearFilteringAsync();
        }
        else if (args.Item.Id == "clear_selection")
        {
            await this.Grid.ClearSelectionAsync();
        }
        else if (args.Item.Id == "grid_properties")
        {
            DialogVisibility = true;
            this.Visibility = true;
            SelectedListValue = "Header Settings";
        }
    }

