    private void FreightColumnBeforeOpen(BeforeOpenCloseMenuEventArgs<MenuFieldData> e)
    {
        foreach (var item in freightSingleColumn)
        {
            if (item.Options != null)
            {
                foreach (var menuitems in item.Options)
                {
                    if (menuitems.CustomText == "Data Operations")
                    {
                        var labelFlags = new Dictionary<string, bool>
                        {
                            { "Enable Grouping", allowGrouping },
                            { "Enable Reordering", allowColumnReordering },
                            { "Enable Resizing", allowColumnResizing },
                            { "Enable Editing", allowEditing }
                        };
                        foreach (var menuSubItems in menuitems.Options)
                        {
                            if (labelFlags.TryGetValue(menuSubItems.Label, out bool isAllowed))
                            {
                                menuSubItems.Disabled = !isAllowed;
                            }
                        }
                    }
                }
            }
        }
    }

    private void ShipAddressColumnBeforeOpen(BeforeOpenCloseMenuEventArgs<MenuFieldData> e)
    {
        foreach (var item in shipAddressSingleColumn)
        {
            if (item.Options != null)
            {
                var labelFlags = new Dictionary<string, bool>
                {
                    { "Enable Grouping", allowGrouping },
                    { "Enable Text Wrap", textwrap },
                    { "Enable Sorting", allowSorting }
                };
                foreach (var menuItem in item.Options)
                {
                    if (menuItem.CustomText == "Single Column Operations" &&
                        labelFlags.TryGetValue(menuItem.Label, out bool isEnabled))
                    {
                        menuItem.Disabled = !isEnabled;
                        if (menuItem.Label == "Enable Text Wrap" && checkboxValues["textwrap"])
                        {
